PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iitconnect?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=8h
ADMIN_PASSWORD=change_this_admin_password
# Fallback price (used only if a mentor has no pricePerSession set — each mentor sets their own price)
SESSION_PRICE=599
GOOGLE_FORM_URL=https://forms.google.com/your-payment-form
# Optional email (app still works without these)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=IIT Connect <your_gmail@gmail.com>
ADMIN_EMAIL=antrikshaaman@gmail.com
NODE_ENV=development

